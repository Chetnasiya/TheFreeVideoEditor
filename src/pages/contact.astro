---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = 'Contact Us — The Free Video Editor';
const seoDescription =
	'Get in touch with The Free Video Editor team. Reach out for support, technical questions, bug reports, feature requests, or partnership inquiries.';
---

<Layout
	title={seoTitle}
	description={seoDescription}
	canonicalUrl="https://thefreevideoeditor.com/contact"
>
	<Header />

	<main class="page-main">
		<div class="page-container">
			<div class="page-header">
				<div class="eyebrow-badge">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>WE ARE HERE TO HELP</span>
				</div>
				<h1 class="page-title">Contact Us</h1>
				<p class="page-lead">
					Have questions, feedback, or a feature request? We’d love to hear from you.
				</p>
			</div>

			<div class="contact-grid">
				<!-- Contact Form -->
				<div class="contact-card form-card">
					<h2>Send Us a Message</h2>
					<form class="contact-form" id="contact-form">
						<div class="form-group">
							<label for="contact-name">Your Name</label>
							<input type="text" id="contact-name" name="name" required placeholder="Alex Creator" autocomplete="name" />
						</div>

						<div class="form-group">
							<label for="contact-email">Email Address</label>
							<input type="email" id="contact-email" name="email" required placeholder="alex@example.com" autocomplete="email" />
						</div>

						<div class="form-group">
							<label for="contact-subject">Topic / Subject</label>
							<select id="contact-subject" name="subject" required>
								<option value="feedback">General Feedback & Suggestions</option>
								<option value="bug">Bug Report / Technical Issue</option>
								<option value="feature">Feature Request (Effects, Audio, AI)</option>
								<option value="partnership">Press & Partnership</option>
								<option value="other">Other Inquiry</option>
							</select>
						</div>

						<div class="form-group">
							<label for="contact-message">Message</label>
							<textarea id="contact-message" name="message" rows="5" required placeholder="Tell us how we can help..."></textarea>
						</div>

						<button type="submit" class="submit-btn">
							<span>Send Message</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="22" y1="2" x2="11" y2="13"></line>
								<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
							</svg>
						</button>

						<div id="form-success" class="form-success-banner" style="display: none;" role="status">
							✓ Thank you! Your message has been received. Our team will review your request shortly.
						</div>
					</form>
				</div>

				<!-- Direct Communication Channels -->
				<div class="channels-column">
					<div class="contact-card info-card">
						<div class="info-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
						</div>
						<h3>Direct Email</h3>
						<p>For support, legal, or direct inquiries:</p>
						<a href="mailto:support@thefreevideoeditor.com" class="channel-link">support@thefreevideoeditor.com</a>
					</div>

					<div class="contact-card info-card">
						<div class="info-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
							</svg>
						</div>
						<h3>Open Source & Community</h3>
						<p>Report issues, contribute, or view architecture discussions:</p>
						<a href="https://github.com" target="_blank" rel="noopener noreferrer" class="channel-link">
							GitHub Repository &rarr;
						</a>
					</div>

					<div class="contact-card info-card faq-shortcut">
						<div class="info-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
								<line x1="12" y1="17" x2="12.01" y2="17"></line>
							</svg>
						</div>
						<h3>Looking for Answers?</h3>
						<p>Check out our frequently asked questions on our home page for instant help on formats, shortcuts, and performance.</p>
						<a href="/#faq-section" class="channel-link">Visit FAQ &rarr;</a>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer currentPage="/contact" />
</Layout>

<style>
	.page-main {
		min-height: 100vh;
		background: #070709;
		color: #e2e8f0;
		padding: 7rem 1.5rem 5rem;
	}

	.page-container {
		max-width: 64rem;
		margin: 0 auto;
	}

	.page-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.eyebrow-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 5px 14px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94a3b8;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		margin-bottom: 1.25rem;
	}

	.pulsing-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.page-title {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #ffffff;
		margin: 0 0 1rem 0;
		line-height: 1.15;
	}

	.page-lead {
		font-size: 1.15rem;
		color: #94a3b8;
		line-height: 1.6;
		margin: 0 auto;
		max-width: 36rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 2rem;
		align-items: start;
	}

	.contact-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 14px;
		padding: 2rem;
	}

	.form-card h2 {
		font-size: 1.4rem;
		color: #ffffff;
		margin: 0 0 0.4rem 0;
		font-weight: 600;
	}

	.form-subtext {
		color: #94a3b8;
		font-size: 0.9rem;
		margin: 0 0 1.75rem 0;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-group label {
		font-size: 0.85rem;
		font-weight: 500;
		color: #cbd5e1;
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		width: 100%;
		padding: 0.7rem 0.9rem;
		border-radius: 8px;
		background: #0f1015;
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #ffffff;
		font-size: 0.95rem;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: #38bdf8;
		box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
	}

	.submit-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 0.8rem 1.75rem;
		border-radius: 9999px;
		background: #ededed;
		border: none;
		color: #090909;
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
		margin-top: 0.5rem;
		transition: all 0.2s ease;
	}

	.submit-btn:hover {
		background: #ffffff;
		box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
		transform: translateY(-1px);
	}

	.form-success-banner {
		padding: 0.85rem 1rem;
		background: rgba(34, 197, 94, 0.12);
		border: 1px solid rgba(34, 197, 94, 0.35);
		border-radius: 8px;
		color: #4ade80;
		font-size: 0.9rem;
		line-height: 1.5;
		margin-top: 0.5rem;
	}

	.channels-column {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.info-card {
		padding: 1.5rem;
	}

	.info-icon {
		display: inline-flex;
		padding: 8px;
		border-radius: 8px;
		background: rgba(56, 189, 248, 0.1);
		color: #38bdf8;
		margin-bottom: 0.75rem;
	}

	.info-card h3 {
		font-size: 1.05rem;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
		font-weight: 600;
	}

	.info-card p {
		color: #94a3b8;
		font-size: 0.875rem;
		line-height: 1.5;
		margin: 0 0 0.85rem 0;
	}

	.channel-link {
		color: #38bdf8;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.9rem;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		transition: color 0.15s ease;
	}

	.channel-link:hover {
		color: #7dd3fc;
		text-decoration: underline;
	}

	@media (max-width: 820px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
	const successBanner = document.getElementById('form-success');
	if (contactForm && successBanner) {
		contactForm.addEventListener('submit', (e) => {
			e.preventDefault();
			successBanner.style.display = 'block';
			contactForm.reset();
		});
	}
</script>

