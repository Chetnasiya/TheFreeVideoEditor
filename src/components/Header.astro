---
import BrandIcon from './BrandIcon.astro';
import BuyMeACoffee from './BuyMeACoffee.astro';

const navItems = [
	{ label: 'Editor', href: '/editor' },
	{ label: 'Features', href: '/#features' },
	{ label: 'About Us', href: '/about' },
	{ label: 'Contact Us', href: '/contact' },
	{ label: 'Privacy Policy', href: '/privacy' },
	{ label: 'Terms & Conditions', href: '/terms' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" id="site-header">
	<div class="header-container">
		<a href="/" class="brand-link" aria-label="The Free Video Editor Home">
			<BrandIcon size={34} />
			<span class="brand-name">The Free Video Editor</span>
		</a>

		<!-- Desktop Navigation -->
		<nav class="site-nav desktop-only" aria-label="Main Navigation">
			<ul class="nav-list">
				{navItems.map((item) => {
					const isActive = currentPath === item.href || (item.href === '/' && currentPath === '');
					return (
						<li>
							<a
								href={item.href}
								class:list={['nav-link', { 'is-active': isActive }]}
								aria-current={isActive ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>

		<div class="header-actions">
		    <a
				href="https://github.com/GajananPalepwad/TheFreeVideoEditor"
				target="_blank"
				rel="noopener noreferrer"
				class="header-github-btn desktop-only"
				aria-label="Contribute on GitHub"
				title="Contribute on GitHub"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
				</svg>
				<span>GitHub</span>
			</a>

			<a href="/editor" class="header-cta-btn desktop-only">
				<span>Open Editor</span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="9 18 15 12 9 6"></polyline>
				</svg>
			</a>

			<!-- Hamburger Toggle Button -->
			<button
				type="button"
				class="mobile-menu-toggle"
				id="mobile-menu-toggle"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-controls="mobile-nav-drawer"
			>
				<span class="hamburger-box">
					<span class="hamburger-line top"></span>
					<span class="hamburger-line middle"></span>
					<span class="hamburger-line bottom"></span>
				</span>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer -->
	<div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true">
		<nav class="mobile-nav" aria-label="Mobile Navigation">
			<ul class="mobile-nav-list">
				{navItems.map((item) => {
					const isActive = currentPath === item.href || (item.href === '/' && currentPath === '');
					return (
						<li>
							<a
								href={item.href}
								class:list={['mobile-nav-link', { 'is-active': isActive }]}
								aria-current={isActive ? 'page' : undefined}
							>
								<span>{item.label}</span>
								{isActive && <span class="active-dot" aria-hidden="true" />}
							</a>
						</li>
					);
				})}
			</ul>

			<div class="mobile-cta-wrapper">
				<a href="/editor" class="mobile-cta-btn">
					<span>Launch Video Editor</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</a>

				<a
					href="https://github.com/GajananPalepwad/TheFreeVideoEditor"
					target="_blank"
					rel="noopener noreferrer"
					class="mobile-github-btn"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
					</svg>
					<span>Contribute on GitHub</span>
				</a>

				<BuyMeACoffee variant="button" text="Buy me a coffee" className="mobile-bmc-btn" />
			</div>
		</nav>
	</div>
</header>

<script>
	function setupMobileMenu() {
		const toggleBtn = document.getElementById('mobile-menu-toggle');
		const drawer = document.getElementById('mobile-nav-drawer');
		const header = document.getElementById('site-header');

		if (!toggleBtn || !drawer || !header) return;

		let isOpen = false;

		function setMenuState(open: boolean) {
			isOpen = open;
			toggleBtn?.setAttribute('aria-expanded', String(isOpen));
			toggleBtn?.classList.toggle('is-active', isOpen);
			drawer?.setAttribute('aria-hidden', String(!isOpen));
			drawer?.classList.toggle('is-open', isOpen);
			header?.classList.toggle('drawer-open', isOpen);
			
			// Lock background scrolling on mobile when open
			if (window.innerWidth <= 820) {
				document.body.style.overflow = isOpen ? 'hidden' : '';
			}
		}

		toggleBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			setMenuState(!isOpen);
		});

		// Close on link click
		drawer.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				setMenuState(false);
			});
		});

		// Close on Escape key
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen) {
				setMenuState(false);
				toggleBtn.focus();
			}
		});

		// Close when resizing above tablet breakpoint
		window.addEventListener('resize', () => {
			if (window.innerWidth > 820 && isOpen) {
				setMenuState(false);
				document.body.style.overflow = '';
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupMobileMenu);
	} else {
		setupMobileMenu();
	}
</script>

<style>
	.site-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		width: 100%;
		padding: 1rem 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(7, 7, 9, 0.75);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	.site-header.drawer-open {
		background: rgba(7, 7, 9, 0.95);
		border-bottom-color: rgba(255, 255, 255, 0.12);
	}

	.header-container {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #ffffff;
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
		transition: opacity 0.15s ease;
		flex-shrink: 0;
		z-index: 52;
	}

	.brand-link:hover {
		opacity: 0.9;
	}

	.brand-name {
		font-family: var(--font-sans);
		white-space: nowrap;
	}

	.site-nav {
		display: flex;
		align-items: center;
	}

	.nav-list {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		display: inline-block;
		padding: 0.4rem 0.75rem;
		border-radius: 6px;
		color: #94a3b8;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 500;
		transition: all 0.15s ease;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}

	.nav-link.is-active {
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.08);
		border: 1px solid rgba(56, 189, 248, 0.2);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.header-github-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 0.45rem 0.85rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #cbd5e1;
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.header-github-btn:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.3);
	}

	.header-cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 0.45rem 1rem;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #ffffff;
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.header-cta-btn:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: rgba(255, 255, 255, 0.4);
		box-shadow: 0 0 16px rgba(255, 255, 255, 0.15);
	}

	/* Hamburger toggle button */
	.mobile-menu-toggle {
		display: none;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 8px;
		padding: 0.5rem;
		cursor: pointer;
		color: #ffffff;
		transition: all 0.2s ease;
		z-index: 52;
	}

	.mobile-menu-toggle:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(255, 255, 255, 0.3);
	}

	.hamburger-box {
		width: 22px;
		height: 16px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
	}

	.hamburger-line {
		width: 100%;
		height: 2px;
		background-color: #ffffff;
		border-radius: 2px;
		transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
		transform-origin: center;
	}

	.mobile-menu-toggle.is-active .hamburger-line.top {
		transform: translateY(7px) rotate(45deg);
	}

	.mobile-menu-toggle.is-active .hamburger-line.middle {
		opacity: 0;
		transform: scaleX(0);
	}

	.mobile-menu-toggle.is-active .hamburger-line.bottom {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* Mobile drawer */
	.mobile-nav-drawer {
		display: none;
	}

	@media (max-width: 820px) {
		.site-header {
			position: absolute;
			top: 0;
			padding: 0.75rem 1.25rem;
		}

		.desktop-only {
			display: none !important;
		}

		.mobile-menu-toggle {
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.mobile-nav-drawer {
			display: block;
			max-height: 0;
			opacity: 0;
			overflow: hidden;
			transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
			width: 100%;
		}

		.mobile-nav-drawer.is-open {
			max-height: 80vh;
			opacity: 1;
			margin-top: 0.75rem;
			padding-top: 0.75rem;
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			overflow-y: auto;
		}

		.mobile-nav {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
			padding-bottom: 1rem;
		}

		.mobile-nav-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}

		.mobile-nav-link {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.7rem 0.9rem;
			border-radius: 8px;
			color: #cbd5e1;
			text-decoration: none;
			font-size: 0.95rem;
			font-weight: 500;
			transition: all 0.15s ease;
		}

		.mobile-nav-link:hover,
		.mobile-nav-link:focus-visible {
			color: #ffffff;
			background: rgba(255, 255, 255, 0.06);
		}

		.mobile-nav-link.is-active {
			color: #38bdf8;
			background: rgba(56, 189, 248, 0.1);
			font-weight: 600;
		}

		.active-dot {
			width: 6px;
			height: 6px;
			border-radius: 9999px;
			background-color: #38bdf8;
			box-shadow: 0 0 8px #38bdf8;
		}

		.mobile-cta-wrapper {
			padding: 0.25rem 0.5rem 0.5rem;
		}

		.mobile-cta-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			width: 100%;
			padding: 0.75rem 1rem;
			border-radius: 10px;
			background: linear-gradient(135deg, rgba(56, 189, 248, 0.25), rgba(168, 85, 247, 0.25));
			border: 1px solid rgba(56, 189, 248, 0.4);
			color: #ffffff;
			text-decoration: none;
			font-size: 0.9rem;
			font-weight: 600;
			box-shadow: 0 4px 16px rgba(56, 189, 248, 0.15);
			transition: all 0.2s ease;
		}

		.mobile-cta-btn:hover {
			background: linear-gradient(135deg, rgba(56, 189, 248, 0.35), rgba(168, 85, 247, 0.35));
			border-color: rgba(56, 189, 248, 0.6);
			box-shadow: 0 4px 20px rgba(56, 189, 248, 0.3);
		}

		.mobile-github-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			width: 100%;
			margin-top: 0.65rem;
			padding: 0.7rem 1rem;
			border-radius: 10px;
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.15);
			color: #e2e8f0;
			text-decoration: none;
			font-size: 0.88rem;
			font-weight: 500;
			transition: all 0.2s ease;
		}

		.mobile-github-btn:hover {
			background: rgba(255, 255, 255, 0.1);
			color: #ffffff;
			border-color: rgba(255, 255, 255, 0.3);
		}
	}
</style>

