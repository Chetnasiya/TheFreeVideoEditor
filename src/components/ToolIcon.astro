---
interface Props {
	name: string;
	size?: number;
	className?: string;
}

const { name, size = 20, className = '' } = Astro.props;
---

<span class={`tool-icon-wrapper ${className}`} style={`width: ${size}px; height: ${size}px; display: inline-flex; align-items: center; justify-content: center;`}>
	{name === 'select' && (
		<svg width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M2.5 1.5l10 6.5-4.8.8 2.6 4.7-1.8 1-2.6-4.7-3.4 3.2V1.5z" />
		</svg>
	)}
	{name === 'scissors' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="6" cy="6" r="3" />
			<circle cx="6" cy="18" r="3" />
			<line x1="20" y1="4" x2="8.12" y2="15.88" />
			<line x1="14.47" y1="14.48" x2="20" y2="20" />
			<line x1="8.12" y1="8.12" x2="12" y2="12" />
		</svg>
	)}
	{name === 'ripple' && (
		<svg width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M4 3h3v2H6v6h1v2H4V3zm5 2.5l3.5 2.5-3.5 2.5v-5z" />
		</svg>
	)}
	{name === 'track-select' && (
		<svg width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<rect x="2" y="2.5" width="2" height="11" rx="0.5" />
			<path d="M6 4.5l4 3.5-4 3.5V4.5zM10.5 4.5l4 3.5-4 3.5V4.5z" />
		</svg>
	)}
	{name === 'slip' && (
		<svg width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M2 3h2v10H2V3zm10 0h2v10h-2V3zM7.5 5.5L5 8l2.5 2.5V5.5zm1 5L11 8 8.5 5.5v5z" />
		</svg>
	)}
	{name === 'text' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polyline points="4 7 4 4 20 4 20 7" />
			<line x1="9" y1="20" x2="15" y2="20" />
			<line x1="12" y1="4" x2="12" y2="20" />
		</svg>
	)}
	{name === 'rect' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
		</svg>
	)}
	{name === 'mark' && (
		<svg width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
			<path d="M4 1.5h8v8l-4 5-4-5V1.5z" />
		</svg>
	)}
	{name === 'silence' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
			<path d="M19 10v2a7 7 0 0 1-14 0v-2" />
			<line x1="12" y1="19" x2="12" y2="23" />
			<line x1="8" y1="23" x2="16" y2="23" />
		</svg>
	)}
	{name === 'captions' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="2" y="4" width="20" height="16" rx="2" />
			<path d="M7 15h3a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2H7v8zM14 15h3a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3v8z" />
		</svg>
	)}
	{name === 'crosshair' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<line x1="22" y1="12" x2="18" y2="12" />
			<line x1="6" y1="12" x2="2" y2="12" />
			<line x1="12" y1="6" x2="12" y2="2" />
			<line x1="12" y1="22" x2="12" y2="18" />
		</svg>
	)}
	{name === 'gizmo' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="2" />
			<circle cx="3" cy="3" r="2" fill="currentColor" />
			<circle cx="21" cy="3" r="2" fill="currentColor" />
			<circle cx="3" cy="21" r="2" fill="currentColor" />
			<circle cx="21" cy="21" r="2" fill="currentColor" />
		</svg>
	)}
	{name === 'speed' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<polyline points="12 6 12 12 16 14" />
			<path d="M16 2v4M20 5l-3 3" />
		</svg>
	)}
	{name === 'color-wheels' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<circle cx="12" cy="8" r="4" />
			<circle cx="8" cy="15" r="4" />
			<circle cx="16" cy="15" r="4" />
		</svg>
	)}
	{name === 'mixer' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<line x1="4" y1="21" x2="4" y2="14" />
			<line x1="4" y1="10" x2="4" y2="3" />
			<line x1="12" y1="21" x2="12" y2="12" />
			<line x1="12" y1="8" x2="12" y2="3" />
			<line x1="20" y1="21" x2="20" y2="16" />
			<line x1="20" y1="12" x2="20" y2="3" />
			<circle cx="4" cy="12" r="2" fill="currentColor" />
			<circle cx="12" cy="10" r="2" fill="currentColor" />
			<circle cx="20" cy="14" r="2" fill="currentColor" />
		</svg>
	)}
	{name === 'keyframes' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 2l7 10-7 10-7-10z" fill="currentColor" opacity="0.3" />
			<path d="M12 2l7 10-7 10-7-10z" />
		</svg>
	)}
	{name === 'sparkles' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
			<path d="M5 3v4M3 5h4M19 17v4M17 19h4" />
		</svg>
	)}
	{name === 'export' && (
		<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
			<polyline points="17 8 12 3 7 8" />
			<line x1="12" y1="3" x2="12" y2="15" />
		</svg>
	)}
</span>

