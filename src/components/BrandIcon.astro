---
interface Props {
	size?: number;
	className?: string;
}

const { size = 32, className = '' } = Astro.props;
---

<div class:list={['brand-icon-wrapper', className]} style={`width: ${size}px; height: ${size}px;`}>
	<div class="brand-icon-inner">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="#ffffff"
			stroke-width="2.2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="brand-clapperboard"
			aria-hidden="true"
		>
			<path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z"></path>
			<path d="m6.2 5.3 3.1 3.9"></path>
			<path d="m12.4 3.4 3.1 4"></path>
			<path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
		</svg>
	</div>
</div>

<style>
	.brand-icon-wrapper {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.brand-icon-inner {
		width: 100%;
		height: 100%;
		border-radius: 22%;
		background: linear-gradient(45deg, rgb(255, 20, 20) 0%, rgb(252, 63, 63) 27%, rgb(255, 147, 15) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 14px rgba(255, 20, 20, 0.35);
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
		
	.brand-clapperboard {
		width: 66%;
		height: 66%;
		display: block;
	}
</style>

