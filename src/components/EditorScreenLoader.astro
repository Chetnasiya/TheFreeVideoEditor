---
// Modern attractive screen loader for The Free Video Editor
---

<div id="editor-screen-loader" class="editor-screen-loader" aria-live="polite" aria-busy="true">
	<!-- Ambient atmospheric background glow -->
	<div class="loader-backdrop">
		<div class="loader-aura loader-aura-cyan"></div>
		<div class="loader-aura loader-aura-purple"></div>
		<div class="loader-grid"></div>
	</div>

	<!-- Central brand loader container -->
	<div class="loader-card">
		<!-- Glowing Icon Emblem -->
		<div class="loader-emblem-wrap">
			<div class="loader-emblem-halo"></div>
			<div class="loader-emblem">
				<!-- Animated shine sweep -->
				<div class="loader-emblem-shine"></div>
				<!-- Futuristic Clapper / Play SVG -->
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 32 32"
					fill="none"
					class="loader-emblem-svg"
					aria-hidden="true"
				>
					<defs>
						<linearGradient id="loaderIconGrad" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#38bdf8" />
							<stop offset="50%" stop-color="#818cf8" />
							<stop offset="100%" stop-color="#c084fc" />
						</linearGradient>
					</defs>
					<path
						d="M26.5 8.5 L5.5 14.5 L4.5 11.5 C4.1 10.1 4.9 8.7 6.3 8.3 L22.8 3.5 C24.2 3.1 25.6 3.9 26 5.3 Z"
						fill="url(#loaderIconGrad)"
					/>
					<path d="M9.5 7.5 L13 12.5" stroke="#09090f" stroke-width="1.8" stroke-linecap="round" />
					<path d="M17 5.5 L20.5 10.5" stroke="#09090f" stroke-width="1.8" stroke-linecap="round" />
					<rect
						x="4.5"
						y="13.5"
						width="23"
						height="14"
						rx="3.5"
						fill="url(#loaderIconGrad)"
					/>
					<!-- Play triangle cut-out inside clapper -->
					<polygon points="14,17.5 20,20.5 14,23.5" fill="#09090f" />
				</svg>
			</div>
		</div>

		<!-- Branding Titles & Spec Badge -->
		<div class="loader-content">
			<div class="loader-title-wrap">
				<h1 class="loader-brand-title">The Free Video Editor</h1>
				<div class="loader-badge">
					<span class="loader-dot"></span>
					<span>4K 60FPS · WEBCODECS · LOCAL GPU</span>
				</div>
			</div>

			<!-- Sleek Gradient Progress Bar -->
			<div class="loader-progress-track">
				<div class="loader-progress-bar"></div>
			</div>

			<!-- Cycling Subsystem Status Indicator -->
			<div class="loader-status" id="loader-status-msg">
				INITIALIZING GPU ENGINE…
			</div>
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		var messages = [
			'INITIALIZING GPU ENGINE…',
			'CALIBRATING WEBCODECS PIPELINE…',
			'MOUNTING MULTI-TRACK TIMELINE…',
			'PREPARING 4K WORKSPACE…',
			'READY.'
		];
		var idx = 0;
		var statusEl = document.getElementById('loader-status-msg');
		var interval = setInterval(function () {
			if (!statusEl || document.getElementById('editor-screen-loader')?.classList.contains('is-ready')) {
				clearInterval(interval);
				return;
			}
			idx = (idx + 1) % messages.length;
			statusEl.textContent = messages[idx];
		}, 550);
	})();
</script>

<style>
	.editor-screen-loader {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #07070a;
		user-select: none;
		overflow: hidden;
		opacity: 1;
		transform: scale(1);
		filter: blur(0);
		transition:
			opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			filter 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0.45s;
	}

	.editor-screen-loader.is-ready {
		opacity: 0;
		transform: scale(1.03);
		filter: blur(8px);
		pointer-events: none;
		visibility: hidden;
	}

	/* Atmospheric backdrop lighting */
	.loader-backdrop {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.loader-aura {
		position: absolute;
		border-radius: 50%;
		filter: blur(90px);
		opacity: 0.55;
		animation: auraPulse 4s ease-in-out infinite alternate;
	}

	.loader-aura-cyan {
		width: 480px;
		height: 480px;
		top: calc(50% - 280px);
		left: calc(50% - 240px);
		background: radial-gradient(circle, rgba(56, 189, 248, 0.22) 0%, transparent 70%);
	}

	.loader-aura-purple {
		width: 420px;
		height: 420px;
		top: calc(50% - 140px);
		left: calc(50% - 210px);
		background: radial-gradient(circle, rgba(168, 85, 247, 0.16) 0%, transparent 70%);
		animation-delay: -2s;
	}

	.loader-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
		background-size: 40px 40px;
		opacity: 0.65;
		mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 75%);
		-webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 75%);
	}

	/* Center Card */
	.loader-card {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		padding: 32px 24px;
		max-width: 90vw;
	}

	/* Emblem with halo */
	.loader-emblem-wrap {
		position: relative;
		display: grid;
		place-items: center;
	}

	.loader-emblem-halo {
		position: absolute;
		width: 100px;
		height: 100px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(56, 189, 248, 0.4) 0%, rgba(139, 92, 246, 0.25) 50%, transparent 75%);
		filter: blur(28px);
		animation: haloPulse 2.8s ease-in-out infinite;
	}

	.loader-emblem {
		position: relative;
		width: 76px;
		height: 76px;
		border-radius: 22px;
		background: linear-gradient(145deg, #181822 0%, #0d0d14 100%);
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow:
			0 20px 45px -10px rgba(0, 0, 0, 0.8),
			0 0 25px rgba(56, 189, 248, 0.2),
			inset 0 1px 1px rgba(255, 255, 255, 0.25);
		display: grid;
		place-items: center;
		overflow: hidden;
		animation: emblemFloat 3.2s ease-in-out infinite;
	}

	.loader-emblem-shine {
		position: absolute;
		top: -50%;
		left: -60%;
		width: 200%;
		height: 200%;
		background: linear-gradient(
			60deg,
			transparent 40%,
			rgba(255, 255, 255, 0.12) 50%,
			transparent 60%
		);
		transform: rotate(25deg);
		animation: shineSweep 3.2s ease-in-out infinite;
		pointer-events: none;
	}

	.loader-emblem-svg {
		width: 36px;
		height: 36px;
		filter: drop-shadow(0 2px 8px rgba(56, 189, 248, 0.4));
	}

	/* Text Content */
	.loader-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		text-align: center;
	}

	.loader-title-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
	}

	.loader-brand-title {
		margin: 0;
		font-family: 'Geist Variable', Geist, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.loader-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 10px;
		border-radius: 9999px;
		background: rgba(56, 189, 248, 0.08);
		border: 1px solid rgba(56, 189, 248, 0.2);
		color: #7dd3fc;
		font-family: 'Geist Mono Variable', 'Geist Mono', ui-monospace, monospace;
		font-size: 10.5px;
		font-weight: 500;
		letter-spacing: 0.05em;
	}

	.loader-dot {
		width: 5.5px;
		height: 5.5px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 8px #22c55e;
		animation: dotPulse 1.8s ease-in-out infinite;
	}

	/* Progress bar */
	.loader-progress-track {
		width: 260px;
		height: 3.5px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.07);
		overflow: hidden;
		position: relative;
		box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
	}

	.loader-progress-bar {
		position: absolute;
		top: 0;
		bottom: 0;
		left: -40%;
		width: 60%;
		border-radius: 9999px;
		background: linear-gradient(90deg, transparent 0%, #38bdf8 30%, #818cf8 70%, #c084fc 100%);
		box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
		animation: progressSweep 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	/* Status text */
	.loader-status {
		font-family: 'Geist Mono Variable', 'Geist Mono', ui-monospace, monospace;
		font-size: 10.5px;
		font-weight: 500;
		color: #71717a;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		min-height: 16px;
	}

	/* Keyframes */
	@keyframes auraPulse {
		0% {
			transform: scale(0.92);
			opacity: 0.45;
		}
		100% {
			transform: scale(1.08);
			opacity: 0.65;
		}
	}

	@keyframes haloPulse {
		0%, 100% {
			transform: scale(0.9);
			opacity: 0.4;
		}
		50% {
			transform: scale(1.15);
			opacity: 0.65;
		}
	}

	@keyframes emblemFloat {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-3px);
		}
	}

	@keyframes shineSweep {
		0% {
			transform: translate(-100%, -100%) rotate(25deg);
		}
		40%, 100% {
			transform: translate(100%, 100%) rotate(25deg);
		}
	}

	@keyframes dotPulse {
		0%, 100% {
			opacity: 1;
			transform: scale(1);
		}
		50% {
			opacity: 0.4;
			transform: scale(0.85);
		}
	}

	@keyframes progressSweep {
		0% {
			left: -40%;
			width: 30%;
		}
		50% {
			left: 20%;
			width: 60%;
		}
		100% {
			left: 100%;
			width: 30%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.editor-screen-loader {
			transition: opacity 0.15s ease !important;
		}
		.loader-aura,
		.loader-emblem-halo,
		.loader-emblem,
		.loader-emblem-shine,
		.loader-dot,
		.loader-progress-bar {
			animation: none !important;
		}
	}
</style>

