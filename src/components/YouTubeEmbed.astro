---
import { extractYoutubeId } from '../data/guides';

interface Props {
	videoId?: string | null;
	videoUrl?: string;
	title: string;
	toolId?: string;
}

const { videoId, videoUrl, title, toolId } = Astro.props;
const resolvedId = extractYoutubeId(videoId || videoUrl);
---

<div class="video-embed-container" data-tool-id={toolId}>
	{resolvedId ? (
		<div class="video-frame-wrapper">
			<iframe
				src={`https://www.youtube-nocookie.com/embed/${resolvedId}?rel=0&modestbranding=1`}
				title={`${title} Video Tutorial — The Free Video Editor`}
				class="video-iframe"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
				loading="lazy"
			/>
		</div>
	) : (
		<div class="video-placeholder-card" role="region" aria-label={`Video tutorial for ${title} coming soon`}>
			<div class="placeholder-ambient-glow" aria-hidden="true" />
			<div class="placeholder-content">
				<div class="yt-play-icon-badge" aria-hidden="true">
					<svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
				</div>
				<div class="placeholder-badge">
					<span class="badge-dot" aria-hidden="true" />
					<span>VIDEO TUTORIAL COMING SOON</span>
				</div>
				<h3 class="placeholder-title">
					Master the {title}
				</h3>
				<p class="placeholder-description">
					The official video walkthrough for the <strong>{title}</strong> is currently being prepared. Check out the comprehensive, step-by-step written guide and pro tips below.
				</p>
				<div class="placeholder-actions">
					<a href="#how-to-use" class="jump-to-steps-btn">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="12" y1="5" x2="12" y2="19"/>
							<polyline points="19 12 12 19 5 12"/>
						</svg>
						<span>Jump to Step-by-Step Instructions</span>
					</a>
				</div>
				<div class="placeholder-note" aria-hidden="true">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"/>
						<line x1="12" y1="16" x2="12" y2="12"/>
						<line x1="12" y1="8" x2="12.01" y2="8"/>
					</svg>
					<span>YouTube link slot active: Add video ID in <code>src/data/guides.ts</code></span>
				</div>
			</div>
		</div>
	)}
</div>

<style>
	.video-embed-container {
		width: 100%;
		margin: 2rem 0;
	}

	.video-frame-wrapper {
		position: relative;
		width: 100%;
		padding-top: 56.25%; /* 16:9 Aspect Ratio */
		border-radius: 16px;
		overflow: hidden;
		background: #090909;
		border: 1px solid var(--color-hairline, rgba(255, 255, 255, 0.1));
		box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.5);
	}

	.video-iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-placeholder-card {
		position: relative;
		width: 100%;
		min-height: 380px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%), #0c0c0c;
		border: 1px dashed rgba(255, 255, 255, 0.15);
		overflow: hidden;
		padding: 3rem 1.5rem;
		text-align: center;
		box-shadow: 0 4px 24px -4px rgba(0, 0, 0, 0.4);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.video-placeholder-card:hover {
		border-color: rgba(255, 0, 0, 0.35);
	}

	.placeholder-ambient-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 320px;
		height: 220px;
		background: radial-gradient(circle, rgba(255, 0, 0, 0.12) 0%, rgba(255, 0, 0, 0) 70%);
		pointer-events: none;
		filter: blur(40px);
	}

	.placeholder-content {
		position: relative;
		z-index: 1;
		max-width: 580px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.yt-play-icon-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: rgba(255, 0, 0, 0.12);
		color: #ff0000;
		border: 1px solid rgba(255, 0, 0, 0.25);
		margin-bottom: 1.25rem;
		box-shadow: 0 0 24px rgba(255, 0, 0, 0.2);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
	}

	.video-placeholder-card:hover .yt-play-icon-badge {
		transform: scale(1.08);
		box-shadow: 0 0 32px rgba(255, 0, 0, 0.4);
		background: rgba(255, 0, 0, 0.18);
	}

	.placeholder-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 12px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #a1a1aa;
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ff0000;
		box-shadow: 0 0 6px #ff0000;
		animation: pulse-dot 2s infinite ease-in-out;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(0.85); }
	}

	.placeholder-title {
		font-size: 1.5rem;
		font-weight: 600;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		letter-spacing: -0.02em;
	}

	.placeholder-description {
		font-size: 0.94rem;
		color: #a1a1aa;
		line-height: 1.6;
		margin: 0 0 1.5rem 0;
	}

	.placeholder-description strong {
		color: #ffffff;
	}

	.placeholder-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-bottom: 1.25rem;
	}

	.jump-to-steps-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 0.6rem 1.4rem;
		border-radius: 9999px;
		background: #ffffff;
		color: #090909;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.jump-to-steps-btn:hover {
		background: #ededed;
		transform: translateY(-1px);
	}

	.placeholder-note {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.76rem;
		color: #71717a;
		font-family: var(--font-mono, monospace);
	}

	.placeholder-note code {
		background: rgba(255, 255, 255, 0.08);
		padding: 2px 6px;
		border-radius: 4px;
		color: #d4d4d8;
	}

	@media (max-width: 640px) {
		.video-placeholder-card {
			min-height: 320px;
			padding: 2rem 1rem;
		}

		.placeholder-title {
			font-size: 1.25rem;
		}

		.placeholder-description {
			font-size: 0.85rem;
		}
	}
</style>

