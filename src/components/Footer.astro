---
import BrandIcon from './BrandIcon.astro';

interface Props {
	currentPage?: string;
}

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-grid">
			<div class="footer-col brand-col">
				<a href="/" class="footer-brand" aria-label="The Free Video Editor Home">
					<BrandIcon size={28} />
					<span>The Free Video Editor</span>
				</a>
				<p class="footer-desc">
					Free, private, browser-based professional video editor with WebCodecs, WebGL2, and zero cloud uploads. Your files never leave your device.
				</p>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Product</h4>
				<ul class="footer-links-list">
					<li><a href="/editor">Launch Editor</a></li>
					<li><a href="/#features">Features</a></li>
					<li><a href="/#faq-section">FAQ</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Company</h4>
				<ul class="footer-links-list">
					<li><a href="/about">About Us</a></li>
					<li><a href="/contact">Contact Us</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Community</h4>
				<ul class="footer-links-list">
					<li>
						<a href="https://github.com/GajananPalepwad/TheFreeVideoEditor" target="_blank" rel="noopener noreferrer" class="github-link">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
							</svg>
							<span>Contribute on GitHub</span>
						</a>
					</li>
					<li><a href="https://github.com/GajananPalepwad/TheFreeVideoEditor/issues" target="_blank" rel="noopener noreferrer">Report an Issue</a></li>
					<li><a href="https://github.com/GajananPalepwad/TheFreeVideoEditor/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contribution Guide</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Legal & Trust</h4>
				<ul class="footer-links-list">
					<li><a href="/privacy">Privacy Policy</a></li>
					<li><a href="/terms">Terms & Conditions</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<div class="footer-bottom-left">
				<p class="copyright-text">
					&copy; {currentYear} The Free Video Editor. All rights reserved.
				</p>
				<div class="made-by-wrapper">
					<span class="made-by-label">Made by</span>
					<a href="https://beestack.in" target="_blank" rel="noopener noreferrer" class="beestack-badge" aria-label="Made by Beestack">
						<img src="/beestack.svg" alt="Beestack Logo" class="beestack-logo" />
					</a>
				</div>
			</div>
			<div class="bottom-links">
				<a href="https://github.com/GajananPalepwad/TheFreeVideoEditor" target="_blank" rel="noopener noreferrer">GitHub</a>
				<span class="sep">&middot;</span>
				<a href="/privacy">Privacy</a>
				<span class="sep">&middot;</span>
				<a href="/terms">Terms</a>
				<span class="sep">&middot;</span>
				<a href="/contact">Support</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		background: #09090c;
		padding: 3.5rem 1.5rem 2rem;
		color: #94a3b8;
		font-size: 0.875rem;
	}

	.footer-container {
		max-width: 72rem;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #ffffff;
		font-weight: 600;
		font-size: 1rem;
		margin-bottom: 0.85rem;
	}

	.brand-logo {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 6px;
		background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(168, 85, 247, 0.25));
		border: 1px solid rgba(56, 189, 248, 0.4);
		color: #38bdf8;
	}

	.footer-desc {
		color: #64748b;
		line-height: 1.6;
		font-size: 0.85rem;
		max-width: 24rem;
		margin: 0;
	}

	.col-title {
		color: #ffffff;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 1rem 0;
	}

	.footer-links-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-links-list a {
		color: #94a3b8;
		text-decoration: none;
		transition: color 0.15s ease;
		font-size: 0.85rem;
	}

	.footer-links-list a:hover {
		color: #38bdf8;
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 1.75rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.footer-bottom-left {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.copyright-text {
		color: #64748b;
		font-size: 0.8rem;
		margin: 0;
	}

	.made-by-wrapper {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.made-by-label {
		color: #64748b;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 500;
	}

	.beestack-badge {
		display: inline-flex;
		align-items: center;
		padding: 3px 8px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 6px;
		transition: all 0.2s ease;
		text-decoration: none;
	}

	.beestack-badge:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.25);
		transform: translateY(-1px);
	}

	.beestack-logo {
		height: 18px;
		width: auto;
		display: block;
		border-radius: 3px;
	}

	.bottom-links {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.bottom-links a {
		color: #64748b;
		text-decoration: none;
		font-size: 0.8rem;
		transition: color 0.15s ease;
	}

	.bottom-links a:hover {
		color: #cbd5e1;
	}

	.sep {
		color: #475569;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}

		.brand-col {
			grid-column: span 2;
		}
	}

	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.brand-col {
			grid-column: span 1;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
	}
</style>

