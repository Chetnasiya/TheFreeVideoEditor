---
interface Props {
	currentPage?: string;
}

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-grid">
			<div class="footer-col brand-col">
				<a href="/" class="footer-brand" aria-label="The Free Video Editor Home">
					<div class="brand-logo" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="5 3 19 12 5 21 5 3"></polygon>
						</svg>
					</div>
					<span>The Free Video Editor</span>
				</a>
				<p class="footer-desc">
					Free, private, browser-based professional video editor with WebCodecs, WebGL2, and zero cloud uploads. Your files never leave your device.
				</p>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Product</h4>
				<ul class="footer-links-list">
					<li><a href="/editor">Launch Editor</a></li>
					<li><a href="/#about-section">Features</a></li>
					<li><a href="/#faq-section">FAQ</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Company</h4>
				<ul class="footer-links-list">
					<li><a href="/about">About Us</a></li>
					<li><a href="/contact">Contact Us</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="col-title">Legal & Trust</h4>
				<ul class="footer-links-list">
					<li><a href="/privacy">Privacy Policy</a></li>
					<li><a href="/terms">Terms & Conditions</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="copyright-text">
				&copy; {currentYear} The Free Video Editor. All rights reserved. 100% Free & Open Web Native.
			</p>
			<div class="bottom-links">
				<a href="/privacy">Privacy</a>
				<span class="sep">&middot;</span>
				<a href="/terms">Terms</a>
				<span class="sep">&middot;</span>
				<a href="/contact">Support</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		background: #09090c;
		padding: 3.5rem 1.5rem 2rem;
		color: #94a3b8;
		font-size: 0.875rem;
	}

	.footer-container {
		max-width: 72rem;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 2.5rem;
		margin-bottom: 3rem;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #ffffff;
		font-weight: 600;
		font-size: 1rem;
		margin-bottom: 0.85rem;
	}

	.brand-logo {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 6px;
		background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(168, 85, 247, 0.25));
		border: 1px solid rgba(56, 189, 248, 0.4);
		color: #38bdf8;
	}

	.footer-desc {
		color: #64748b;
		line-height: 1.6;
		font-size: 0.85rem;
		max-width: 24rem;
		margin: 0;
	}

	.col-title {
		color: #ffffff;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 1rem 0;
	}

	.footer-links-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-links-list a {
		color: #94a3b8;
		text-decoration: none;
		transition: color 0.15s ease;
		font-size: 0.85rem;
	}

	.footer-links-list a:hover {
		color: #38bdf8;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 1.75rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.copyright-text {
		color: #64748b;
		font-size: 0.8rem;
		margin: 0;
	}

	.bottom-links {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.bottom-links a {
		color: #64748b;
		text-decoration: none;
		font-size: 0.8rem;
		transition: color 0.15s ease;
	}

	.bottom-links a:hover {
		color: #cbd5e1;
	}

	.sep {
		color: #475569;
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}

		.brand-col {
			grid-column: span 2;
		}
	}

	@media (max-width: 480px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.brand-col {
			grid-column: span 1;
		}
	}
</style>

