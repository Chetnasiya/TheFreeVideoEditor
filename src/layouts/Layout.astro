---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	ogType?: string;
	ogImage?: string;
	keywords?: string;
}

const {
	title = 'The Free Video Editor — Free Online Video Editor & AI Video Editor in Your Browser',
	description = 'The Free Video Editor is a fast, free online video editor and AI video editor in your browser. Edit 4K timeline video with zero cloud upload, private local processing, and no watermark.',
	canonicalUrl = 'https://thefreevideoeditor.com',
	ogType = 'website',
	ogImage = 'https://thefreevideoeditor.com/og-image.png',
	keywords = 'video editor, free video editor, online video editor, ai video editor, video editor online, video editor free, youtube video editor, capcut video editor, canva video editor, movavi video editor, adobe video editor, windows video editor, free ai video editor, openshot video editor, free online video editor, best free video editor, ai video editor free, microsoft video editor, best video editor, video editor jobs'
} = Astro.props;

const siteUrl = 'https://thefreevideoeditor.com';
const currentCanonical = canonicalUrl || siteUrl;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta
			name="robots"
			content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
		/>
		<meta name="theme-color" content="#090909" />
		<link rel="canonical" href={currentCanonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={currentCanonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta
			property="og:image:alt"
			content="The Free Video Editor — Free Online AI Video Editor in Your Browser"
		/>
		<meta property="og:site_name" content="The Free Video Editor" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={currentCanonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta
			name="twitter:image:alt"
			content="The Free Video Editor — Free Online AI Video Editor in Your Browser"
		/>

		<!-- Structured Data (JSON-LD) for SoftwareApplication & WebSite -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify([
				{
					'@context': 'https://schema.org',
					'@type': 'WebSite',
					name: 'The Free Video Editor',
					url: 'https://thefreevideoeditor.com',
					description: description,
					potentialAction: {
						'@type': 'SearchAction',
						target: 'https://thefreevideoeditor.com/editor?q={search_term_string}',
						'query-input': 'required name=search_term_string'
					}
				},
				{
					'@context': 'https://schema.org',
					'@type': 'WebApplication',
					name: 'The Free Video Editor',
					url: 'https://thefreevideoeditor.com',
					applicationCategory: 'MultimediaApplication',
					operatingSystem: 'All modern web browsers (Chrome, Edge, Firefox, Safari)',
					offers: {
						'@type': 'Offer',
						price: '0',
						priceCurrency: 'USD'
					},
					description:
						'A free online video editor and AI video editor running locally in the browser with WebCodecs, WebGL2, multi-track timeline, automatic captions, and zero cloud uploads.'
				}
			])}
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
